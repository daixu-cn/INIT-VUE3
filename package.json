{
  "name": "echo-web",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "author": "Jianvey <Jianvey@outlook.com> (https://github.com/Jianvey)",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "vite",
    "preview": "vite preview",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "architecture:check": "node scripts/check-source-size.mjs && node scripts/check-style-tokens.mjs",
    "format:check": "prettier --check src scripts config vite.config.ts tsconfig*.json .github package.json eslint.config.mjs --ignore-unknown && prettier --check docs --ignore-path /dev/null --no-error-on-unmatched-pattern",
    "lint:check": "eslint . --max-warnings=0",
    "quality": "pnpm format:check && pnpm lint:check && pnpm type-check && pnpm architecture:check && pnpm build",
    "lint": "eslint . --fix",
    "prettier": "prettier --write src scripts config vite.config.ts tsconfig*.json .github package.json eslint.config.mjs --ignore-unknown && prettier --write docs --ignore-path /dev/null --no-error-on-unmatched-pattern",
    "commit": "git-cz",
    "husky-install": "pnpm exec husky init && echo 'pnpm quality' > .husky/pre-commit && echo 'pnpm exec commitlint --edit \"$1\"' > .husky/commit-msg",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "axios": "^1.15.0",
    "gsap": "^3.15.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vuetify": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/cz-commitlint": "^20.5.1",
    "@commitlint/prompt-cli": "^20.5.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^25.5.2",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.1",
    "eslint": "^10.2.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "3.2.6"
  }
}
